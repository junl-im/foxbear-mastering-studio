# Do not put the Gmail app password in this file or commit it.
# Configure it with Firebase Secret Manager instead:
# firebase functions:secrets:set FOXBEAR_GMAIL_APP_PASSWORD

# Optional independent operations alert channel. Supported HTTPS hosts: Slack, Discord, Google Chat, Microsoft Teams.
FOXBEAR_INCIDENT_ALERT_WEBHOOK_URL=

# Optional secondary channel used after bounded primary retries fail.
FOXBEAR_INCIDENT_ALERT_WEBHOOK_FALLBACK_URL=

# Optional operational mail routing overrides. If omitted, the existing production address remains the fallback.
# FOXBEAR_ALERT_SENDER must match the Gmail account associated with FOXBEAR_GMAIL_APP_PASSWORD.
# Production should set BOTH mail routing variables; administrator readiness reports a warning while either falls back.
FOXBEAR_ALERT_RECIPIENT=
FOXBEAR_ALERT_SENDER=
