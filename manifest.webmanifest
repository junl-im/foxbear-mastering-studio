{
  "name": "FoxBear AI Mastering Studio",
  "short_name": "FoxBear",
  "description": "로컬 브라우저에서 오디오를 분석하고 AI 마스터링하는 모바일 친화형 스튜디오",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#07111c",
  "theme_color": "#101f36",
  "orientation": "any",
  "lang": "ko-KR",
  "dir": "ltr",
  "categories": ["music", "productivity", "utilities"],
  "icons": [
    {
      "src": "assets/icons/foxbear-music.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "새 마스터링",
      "short_name": "새 작업",
      "description": "FoxBear 마스터링 화면을 바로 엽니다.",
      "url": "./?shortcut=new-mastering",
      "icons": [{ "src": "assets/icons/foxbear-music.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "다운로드 대기 파일",
      "short_name": "다운로드",
      "description": "완성된 마스터 파일을 저장하거나 공유합니다.",
      "url": "./?shortcut=downloads",
      "icons": [{ "src": "assets/icons/foxbear-music.png", "sizes": "512x512", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "video/mp4", "video/quicktime", "video/3gpp", "application/ogg", ".wav", ".wave", ".mp3", ".mpeg", ".mpga", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".aif", ".aiff", ".aifc", ".caf", ".webm", ".weba", ".mp4", ".m4v", ".mov", ".3gp", ".3gpp", ".3g2", ".amr", ".wma"]
        }
      ]
    }
  }
}
