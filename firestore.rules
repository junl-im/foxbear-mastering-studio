rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGoogleIdentity() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isGoogleIdentity()
        && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.active == true
        && (
          !('email' in get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.email == request.auth.token.email
        )
        && (
          !('authProvider' in get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.authProvider == 'google.com'
        )
        && (
          !('expiresAt' in get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.expiresAt > request.time
        );
    }

    function validShortString(field, maxSize) {
      return field is string && field.size() <= maxSize;
    }

    function validVisitCreate(visitId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'visitorId',
          'createdAt',
          'clientAt',
          'dateKey',
          'referrer',
          'page',
          'path',
          'language',
          'userAgent',
          'screen',
          'appVersion',
          'source',
          'storageUsed'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validShortString(request.resource.data.clientAt, 40)
        && validShortString(request.resource.data.dateKey, 10)
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && visitId == request.auth.uid + '_' + request.resource.data.dateKey
        && validShortString(request.resource.data.referrer, 160)
        && validShortString(request.resource.data.page, 180)
        && validShortString(request.resource.data.path, 160)
        && validShortString(request.resource.data.language, 24)
        && validShortString(request.resource.data.userAgent, 220)
        && validShortString(request.resource.data.screen, 32)
        && validShortString(request.resource.data.appVersion, 24)
        && request.resource.data.source == 'foxbear-web-client'
        && request.resource.data.storageUsed == false;
    }

    match /siteVisits/{visitId} {
      allow create: if validVisitCreate(visitId);
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update, delete: if false;
    }


    function validIncidentCreate(reportId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'createdAt',
          'schemaVersion',
          'clientAt',
          'appVersion',
          'assetVersion',
          'severity',
          'category',
          'reason',
          'message',
          'code',
          'stack',
          'fingerprint',
          'submissionKey',
          'source',
          'pagePath',
          'browser',
          'platform',
          'language',
          'viewport',
          'online',
          'visibility',
          'memoryGb',
          'cpuCores',
          'runtimeOk',
          'resourceFailureCount',
          'runtimeErrorCount',
          'runtimeWarningCount',
          'bootFailed',
          'bootStalled',
          'automatic',
          'context',
          'delivery'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.schemaVersion == 1
        && request.resource.data.severity in ['warning', 'error', 'fatal']
        && request.resource.data.category in [
          'runtime', 'resource', 'boot', 'mastering', 'mastering-memory', 'quality-recovery', 'export',
          'update-safety', 'release-mismatch', 'firebase', 'manual-test', 'unknown'
        ]
        && validShortString(request.resource.data.clientAt, 40)
        && validShortString(request.resource.data.appVersion, 24)
        && validShortString(request.resource.data.assetVersion, 80)
        && validShortString(request.resource.data.reason, 100)
        && validShortString(request.resource.data.message, 500)
        && validShortString(request.resource.data.code, 80)
        && validShortString(request.resource.data.stack, 1400)
        && validShortString(request.resource.data.fingerprint, 64)
        && validShortString(request.resource.data.submissionKey, 64)
        && request.resource.data.submissionKey.matches('^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$')
        && reportId == request.auth.uid + '_' + request.resource.data.submissionKey
        && validShortString(request.resource.data.source, 80)
        && validShortString(request.resource.data.pagePath, 160)
        && validShortString(request.resource.data.browser, 40)
        && validShortString(request.resource.data.platform, 40)
        && validShortString(request.resource.data.language, 24)
        && validShortString(request.resource.data.viewport, 32)
        && validShortString(request.resource.data.visibility, 20)
        && validShortString(request.resource.data.context, 700)
        && request.resource.data.online is bool
        && request.resource.data.runtimeOk is bool
        && request.resource.data.bootFailed is bool
        && request.resource.data.bootStalled is bool
        && request.resource.data.automatic is bool
        && request.resource.data.memoryGb is number
        && request.resource.data.memoryGb >= 0
        && request.resource.data.memoryGb <= 64
        && request.resource.data.cpuCores is number
        && request.resource.data.cpuCores >= 0
        && request.resource.data.cpuCores <= 64
        && request.resource.data.resourceFailureCount is number
        && request.resource.data.resourceFailureCount >= 0
        && request.resource.data.resourceFailureCount <= 99
        && request.resource.data.runtimeErrorCount is number
        && request.resource.data.runtimeErrorCount >= 0
        && request.resource.data.runtimeErrorCount <= 99
        && request.resource.data.runtimeWarningCount is number
        && request.resource.data.runtimeWarningCount >= 0
        && request.resource.data.runtimeWarningCount <= 99
        && request.resource.data.delivery is map
        && request.resource.data.delivery.keys().hasOnly(['status', 'attemptCount'])
        && request.resource.data.delivery.status == 'pending'
        && request.resource.data.delivery.attemptCount == 0;
    }

    match /incidentReports/{reportId} {
      allow create: if validIncidentCreate(reportId);
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();
      allow update, delete: if false;
    }

    function validIncidentRetryRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'uid',
          'reportId',
          'source',
          'forceTerminal',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'reportId', 'source', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validShortString(request.resource.data.reportId, 180)
        && request.resource.data.reportId.size() > 0
        && request.resource.data.source == 'foxbear-admin-dashboard'
        && (!('forceTerminal' in request.resource.data) || request.resource.data.forceTerminal is bool);
    }

    match /incidentRetryRequests/{requestId} {
      allow create: if validIncidentRetryRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    function validIncidentBatchRecoveryRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'mode', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'mode', 'source', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.mode in ['recoverable', 'dead-letter']
        && request.resource.data.source == 'foxbear-admin-dashboard';
    }

    match /incidentBatchRecoveryRequests/{requestId} {
      allow create: if validIncidentBatchRecoveryRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }


    function validIncidentAlertTestRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'source', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.source == 'foxbear-admin-dashboard';
    }

    match /incidentAlertTestRequests/{requestId} {
      allow create: if validIncidentAlertTestRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    function validIncidentDeploymentVerificationRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'source', 'expectedVersion', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'source', 'expectedVersion', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.source == 'foxbear-admin-dashboard'
        && validShortString(request.resource.data.expectedVersion, 24);
    }

    match /incidentDeploymentVerificationRequests/{requestId} {
      allow create: if validIncidentDeploymentVerificationRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    function validIncidentMailReceiptConfirmationRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'reportId', 'location', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'reportId', 'location', 'source', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validShortString(request.resource.data.reportId, 180)
        && request.resource.data.reportId.size() > 0
        && request.resource.data.location in ['inbox', 'spam']
        && request.resource.data.source == 'foxbear-admin-dashboard';
    }

    match /incidentMailReceiptConfirmationRequests/{requestId} {
      allow create: if validIncidentMailReceiptConfirmationRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    function validIncidentMailTestCleanupRequest() {
      return isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'mode', 'source', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'mode', 'source', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.mode == 'unconfirmed-24h'
        && request.resource.data.source == 'foxbear-admin-dashboard';
    }

    match /incidentMailTestCleanupRequests/{requestId} {
      allow create: if validIncidentMailTestCleanupRequest();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /incidentMailTestHistory/{testId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /incidentAdminAuditLog/{auditId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /incidentAdminActionState/{document=**} {
      allow read, write: if false;
    }

    match /incidentMailState/{document=**} {
      allow read, write: if false;
    }

    match /incidentOperations/{documentId} {
      allow get: if isAdmin();
      allow list, create, update, delete: if false;
    }

    match /incidentOperationsHistory/{historyId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /incidentOperationsAlerts/{alertId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /siteAdmins/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
