{
  "schemaVersion": 1,
  "targetClient": "GitHub Desktop",
  "applyMode": "extract-overwrite-zip-into-repository-root",
  "productVersion": "1.5.47",
  "buildId": "engine-edgecase-quality-gate",
  "requiredFiles": [
    ".gitignore",
    ".github/workflows/pages.yml",
    ".github/workflows/pages-branch-fallback.yml",
    "CHANGELOG.md",
    "GITHUB_DESKTOP_HANDOFF.md",
    "HANDOFF.md",
    "HANDOFF_PACKAGE.json",
    "PROJECT_NOTES.md",
    "README.md",
    "RELEASE_CHECKLIST.md",
    "STATUS.md",
    "VERSIONING.md",
    "design-preview.html",
    "index.html",
    "manifest.webmanifest",
    "package.json",
    "package-lock.json",
    "playwright.config.js",
    "robots.txt",
    "sw.js",
    "qa/browser/helpers/foxbear-e2e-helpers.js",
    "qa/browser/run-browser-e2e.js",
    "tools/create-overwrite-zip.sh",
    "tools/create-release-zip.sh",
    "tools/verify-handoff-state.js",
    "tools/verify-overwrite-zip.js",
    "tools/verify-release-zip.js",
    "tools/archive-hygiene.js",
    "qa/v1519_ci_runtime_isolation_packaging_smoke.js",
    ".githooks/pre-commit",
    "tools/install-git-hooks.sh",
    "qa/v1539_ci_hook_lifecycle_hardening_smoke.js"
  ],
  "requiredPrefixes": [
    "assets/",
    "docs/",
    "qa/",
    "src/",
    "tools/",
    "vendor/"
  ],
  "forbiddenArchivePrefixes": [
    ".git/",
    ".firebase/",
    "dist/",
    "node_modules/",
    "playwright-report/",
    "qa/browser-results/",
    "test-results/"
  ],
  "forbiddenArchiveFiles": [
    ".firebaserc",
    "check.log",
    "qa/static-audit.txt"
  ],
  "deletePaths": [],
  "requiredRuntimeAssets": [
    "src/audio/mastering-input-guard-service.js",
    "src/download/download-service.js",
    "src/download/export-guard-service.js",
    "src/download/export-progress-view.js",
    "src/download/zip-export-service.js",
    "src/download/export-queue-service.js",
    "src/workers/zip-encoder.worker.js"
  ]
}
